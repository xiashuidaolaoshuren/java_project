# Copy to `.env` for local docker-compose / Spring (do not commit `.env`).
# Docker Compose reads these automatically when present in the project root.

POSTGRES_DB=focusflow
POSTGRES_USER=focusflow
POSTGRES_PASSWORD=focusflow
POSTGRES_PORT=5432

# Spring Boot datasource (align with Postgres service above).
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/focusflow
SPRING_DATASOURCE_USERNAME=focusflow
SPRING_DATASOURCE_PASSWORD=focusflow

# Used with OpenAI-compatible providers (OpenAI, DeepSeek, etc.).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Include the /v1 suffix when the provider uses OpenAI-style paths.
OPENAI_BASE_URL=https://api.openai.com/v1
